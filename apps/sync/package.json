{
  "name": "@wr/sync",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Custom Node WebSocket sync server on y-protocols (home servers, leases, edit log).",
  "exports": {
    ".": "./src/server.ts",
    "./memory": "./src/storage/memory.ts",
    "./access": "./src/access.ts",
    "./pg-access": "./src/pgAccess.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "tsx --env-file-if-exists=../../.env src/main.ts",
    "typecheck": "tsc --noEmit -p .",
    "test:services": "WR_TEST_SERVICES=1 vitest run test/aws-storage.test.ts",
    "test:chaos": "WR_TEST_SERVICES=1 vitest run test/chaos.test.ts --silent=false --testTimeout=180000 --hookTimeout=60000"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1156.0",
    "@aws-sdk/client-s3": "3.1156.0",
    "@wr/auth": "workspace:*",
    "@wr/shared": "workspace:*",
    "lib0": "0.2.119",
    "pg": "8.23.1",
    "ws": "8.22.0",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.2",
    "tsx": "4.23.15"
  }
}
