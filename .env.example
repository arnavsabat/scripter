# Copy to .env for local development. Values match docker-compose.yml (local only).
DATABASE_URL=postgres://wr:wr_dev_only@localhost:5432/writers_room

# AWS SDK clients point at the local emulators.
AWS_REGION=us-east-1
DYNAMODB_ENDPOINT=http://localhost:8000
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY_ID=wr_local
S3_SECRET_ACCESS_KEY=wr_local_secret
S3_SNAPSHOT_BUCKET=wr-snapshots
