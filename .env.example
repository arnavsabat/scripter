# Copy to .env for local development. Values match docker-compose.yml (local only).
DATABASE_URL=postgres://wr:wr_dev_only@localhost:5432/writers_room

# AWS SDK clients point at the local emulators.
AWS_REGION=us-east-1
DYNAMODB_ENDPOINT=http://localhost:8000
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY_ID=wr_local
S3_SECRET_ACCESS_KEY=wr_local_secret
S3_SNAPSHOT_BUCKET=wr-snapshots

# Sync server (apps/sync)
PORT=4000
# Shared by every sync server in a cluster; signs forwarded identities (D-022). Local value only.
WR_CLUSTER_SECRET=dev-only-cluster-secret
WR_EDIT_LOG_TABLE=wr-edit-log
# WR_STORAGE=memory   # development only: skip DynamoDB/S3, lose everything on restart
# WR_STORAGE=aws      # real AWS (no local endpoints); required explicitly so it never happens by accident

# API (apps/api). There is no development sign-in stub (D-030): the API trusts only this Cognito
# user pool, so it can't start until the pool exists (accounts step 8). Tests use a test key instead.
API_PORT=4100
APP_URL=http://localhost:5173
COGNITO_REGION=us-east-2
# COGNITO_USER_POOL_ID=
# COGNITO_CLIENT_ID=
# COGNITO_DOMAIN=https://<prefix>.auth.us-east-2.amazoncognito.com   (for "Continue with Google")
# SES sender for invitation emails (D-038). Unset: invitations are printed to the API's console.
# WR_SENDER_EMAIL=
