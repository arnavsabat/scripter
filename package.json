{
  "name": "writers-room",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.12.1",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "scripts": {
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:services": "pnpm -r --if-present test:services",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "dev:web": "pnpm --filter @wr/web dev",
    "services:up": "docker compose up -d",
    "services:down": "docker compose down",
    "cluster:up": "docker compose --profile cluster up -d --build",
    "cluster:down": "docker compose --profile cluster down"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
