# Copy to infra/.env.local (git-ignored) and fill in. These stay on your machine (D-054).
WR_AWS_REGION=us-east-2
# free until you upgrade the AWS account; then paid (Postgres backups go from 1 day to 7, D-098).
WR_ACCOUNT_PLAN=free
# Budget alerts ($20 / $40) go here.
WR_ALERT_EMAIL=you@example.com
# Sign-in codes and invitations are sent from this address until there's a domain (D-038).
WR_SENDER_EMAIL=you@example.com
# SES's sandbox only sends to verified addresses: the demo's two accounts, comma-separated.
WR_TEST_RECIPIENTS=you@example.com,friend@example.com
# Globally unique: becomes <prefix>.auth.us-east-2.amazoncognito.com
WR_COGNITO_DOMAIN_PREFIX=scripter-yourname
# Where the web app runs (Google returns to <url>/api/auth/google/callback).
WR_APP_URLS=http://localhost:5173
# After creating the Google OAuth client (step 8, part 2):
# WR_GOOGLE_CLIENT_ID=...apps.googleusercontent.com
# WR_GOOGLE_SECRET_NAME=wr/google-oauth
# The beta's domain (D-096). With WR_DOMAIN alone, only WrDns (its Route 53 zone) is made; add
# WR_HOSTED_ZONE_ID from WrDns's output, and every stack uses the domain: the site at
# https://<domain> (added to the app URLs by itself), sign-in at auth.<domain>, and mail from
# no-reply@<domain>. WR_SENDER_EMAIL stays an SES identity.
# WR_DOMAIN=example.com
# WR_HOSTED_ZONE_ID=Z0123456789ABCDEFGHIJ
