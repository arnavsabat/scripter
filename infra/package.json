{
  "name": "@wr/infra",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "AWS CDK app (TypeScript).",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "synth": "cdk synth --quiet",
    "deploy:budgets": "cdk deploy WrBudgets",
    "deploy:email": "cdk deploy WrEmail",
    "deploy:auth": "cdk deploy WrAuth --exclusively",
    "bootstrap": "cdk bootstrap",
    "deploy:data": "cdk deploy WrData",
    "deploy:cert": "cdk deploy WrCert",
    "deploy:app": "VITE_WR_VERSION=$(git rev-parse --short HEAD) pnpm --filter @wr/web build && cdk deploy WrApp --exclusively",
    "diff": "cdk diff",
    "deploy:load": "cdk deploy WrLoad",
    "destroy:load": "cdk destroy WrLoad"
  },
  "dependencies": {
    "aws-cdk-lib": "2.274.0",
    "constructs": "10.8.1"
  },
  "devDependencies": {
    "aws-cdk": "2.1146.1",
    "tsx": "4.23.15"
  }
}
